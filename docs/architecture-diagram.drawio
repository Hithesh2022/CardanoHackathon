                <mxCell id="problem-text" value="• Millions lack access to fair credit&#xa;• Centralized scoring = biased&#xa;• Traditional bureaus exclude users with limited data&#xa;• Insecure storage of personal info&#xa;• No user control over financial identity" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="125" width="280" height="125" as="geometry"/>
